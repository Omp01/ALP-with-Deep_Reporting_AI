# =============================================================================
# Adaptive LMS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=adaptive_lms
POSTGRES_PASSWORD=adaptive_lms_dev_password
POSTGRES_DB=adaptive_lms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://adaptive_lms:adaptive_lms_dev_password@postgres:5432/adaptive_lms
DATABASE_URL_SYNC=postgresql://adaptive_lms:adaptive_lms_dev_password@postgres:5432/adaptive_lms

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MinIO (S3-compatible Object Storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=adaptive-lms-content
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# -----------------------------------------------------------------------------
# AI Provider (ollama | gemini | groq | openai_compatible | none)
#   ollama  = free, local, no key (see docs/ZERO_COST_MODE.md)
#   none    = AI stages report "unavailable"; nothing is ever faked
# Full reference: docs/AI_PROVIDER.md
# -----------------------------------------------------------------------------
AI_PROVIDER=ollama
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# Ollama (AI_PROVIDER=ollama). From Docker on Windows use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional per-task models for content ingestion (empty = the provider's default model).
AI_MODEL_ANALYSIS=
AI_MODEL_QUESTIONS=
AI_MODEL_GRADING=
AI_MODEL_REPORTING=

# Optional embeddings for ingested chunks (an OpenAI-compatible /embeddings endpoint,
# e.g. Ollama's nomic-embed-text). Empty = the embedding stage is skipped.
AI_EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# Competency engine and written-answer grading (docs/COMPETENCY_ENGINE.md, docs/GRADING_AGENT.md)
# Defaults for the deterministic mastery update. They are standard starting values, not fitted to your data.
# -----------------------------------------------------------------------------
MASTERY_PRIOR=0.20
MASTERY_LEARN=0.15
MASTERY_SLIP=0.10
MASTERY_GUESS=0.20
MASTERY_RETRY_WEIGHT=0.60
MASTERY_CONFIDENCE_K=3.0
MASTERY_TREND_WINDOW=5
MASTERY_TREND_MIN_UPDATES=3
MASTERY_TREND_THRESHOLD=0.05
# A written answer graded below this confidence waits for a person instead of counting as evidence.
GRADING_MIN_CONFIDENCE=0.60
GRADING_CORRECT_THRESHOLD=0.70
GRADING_TIMEOUT_SECONDS=90
GRADING_MAX_ANSWER_CHARS=6000

# Reporting AI (docs/REPORTING_AI.md)
REPORTING_TIMEOUT_SECONDS=120
REPORTING_PERIOD_DAYS=30
# An identical evidence package for the same requester within this window reuses the stored report (no model call).
REPORTING_CACHE_MINUTES=30
REPORTING_MIN_RESPONSES_PER_QUESTION=5
REPORTING_MIN_LEARNERS_FOR_CONTENT=3
# Run due scheduled digests inside the API process (otherwise POST /reports/schedules/run-due).
REPORT_SCHEDULER_ENABLED=false
REPORT_SCHEDULER_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Learning events and sessions (docs/EVENT_MODEL.md)
# -----------------------------------------------------------------------------
# A session with no activity for this long is closed at its last activity.
SESSION_IDLE_MINUTES=30
# Publish committed events to the Redis stream in the background (outbox with retry).
EVENT_DISPATCHER_ENABLED=true
EVENT_DISPATCH_INTERVAL_SECONDS=2
# A browser-reported timestamp is used only within these bounds; otherwise the server's time is.
EVENT_CLIENT_CLOCK_SKEW_SECONDS=120
EVENT_CLIENT_MAX_AGE_HOURS=24
EVENT_MAX_CLIENT_BATCH=50

# -----------------------------------------------------------------------------
# Content ingestion (docs/CONTENT_INGESTION.md)
# -----------------------------------------------------------------------------
# Legacy .doc and .ppt cannot be read and are always refused.
ALLOWED_FILE_TYPES=pdf,docx,pptx,txt,md,mp4,webm,mov,mp3,wav,m4a
MAX_UPLOAD_SIZE_MB=100
INGESTION_MAX_ANALYSIS_CHARS=12000
INGESTION_QUESTION_COUNT=6
INGESTION_MIN_TEXT_CHARS=200
INGESTION_STALE_MINUTES=15
# Only used if the optional faster-whisper package is installed (transcribes uploaded audio/video).
WHISPER_MODEL=base

# Bearer token the API uses for the storage service. Empty = MINIO_SECRET_KEY.
STORAGE_TOKEN=

# -----------------------------------------------------------------------------
# Google Gemini API
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# Groq Cloud API
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Embedding Model (sentence-transformers, runs locally)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# Service URLs (internal Docker network)
# -----------------------------------------------------------------------------
API_SERVICE_URL=http://api:8000
ADAPTIVE_ENGINE_URL=http://adaptive-engine:8001
REPORTING_ENGINE_URL=http://reporting-engine:8002
INGESTION_SERVICE_URL=http://ingestion:8003

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Adaptive LMS

# -----------------------------------------------------------------------------
# CORS: browser origins allowed to call the API (comma-separated)
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------
RISK_SCAN_INTERVAL_SECONDS=300
DIGEST_CRON_EXPRESSION=0 8 * * 1
EVENT_STREAM_NAME=learning_events
EVENT_CONSUMER_GROUP=event_workers

# -----------------------------------------------------------------------------
# Upload Limits
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Testing (used only by services/api/tests/foundation)
# -----------------------------------------------------------------------------
# Name of the throwaway database the test suite drops and recreates on every run.
# Must contain "test" and differ from POSTGRES_DB; the runner refuses otherwise.
TEST_DATABASE_NAME=adaptive_lms_test
